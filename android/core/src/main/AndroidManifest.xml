<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- auto-update: check GitHub Releases, download and install the new APK -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- on_wifi() in macros: whether the phone is on Wi-Fi -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- turn the screen on and keep it on while Claude or a macro drives the game (ScreenWake) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <!-- the daily schedule: an exact alarm (Android 13+ grants USE_EXACT_ALARM at install; 12 asks), and set again after a reboot -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ package visibility: needed to launch the game -->
    <queries>
        <package android:name="${gamePackage}" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- turns the screen on when a wake lock can't; a task of its own, so the game comes back in front -->
        <activity
            android:name=".WakeActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="${applicationId}.wake"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <receiver
            android:name=".Updater$InstallResult"
            android:exported="false" />
        <!-- after an unattended dev update: a fallback notification to turn screen capture back on -->
        <receiver
            android:name=".Updater$Replaced"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- the daily schedule's alarm (DailySchedule) and the Allow/Deny buttons of Claude's questions (Alerts) -->
        <receiver
            android:name=".ScheduleReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ApprovalReceiver"
            android:exported="false" />

        <!-- screen capture runs in a foreground service (required for MediaProjection) -->
        <service
            android:name=".MacroService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- taps, holds/slides (walking) and Back, via accessibility gestures -->
        <service
            android:name=".InputService"
            android:exported="false"
            android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_service" />
        </service>
    </application>
</manifest>
